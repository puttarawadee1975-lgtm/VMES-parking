# =========================================================
# AWS & Cloud Infrastructure Configuration (.env)
# =========================================================

# Production: private S3 snapshots uploaded by FastAPI only.
# Use 'local' explicitly for local development storage.
STORAGE_PROVIDER=s3

# Required for S3: supply the deployment region and private bucket name.
AWS_REGION=
AWS_S3_BUCKET=
S3_PRESIGNED_URL_TTL_SECONDS=900

# EC2 uses an IAM instance role through boto3's default credential chain.
# Static AWS keys and a public/custom image domain are not required.
# The edge needs only API_URL for submission, not S3 configuration.

# Database Connection (AWS DocumentDB or MongoDB Atlas Cloud)
MONGODB_URL=
DATABASE_NAME=vmes_parking

# FastAPI Application Settings
HOST=0.0.0.0
PORT=8000
