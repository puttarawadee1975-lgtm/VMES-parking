# =========================================================
# AWS & Cloud Infrastructure Configuration (.env)
# =========================================================

# Storage Provider: 'local' for development, 's3' for AWS S3 Cloud Production
STORAGE_PROVIDER=local

# AWS Credentials & S3 Bucket Settings (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=vmes-parking-snapshots
AWS_S3_CUSTOM_DOMAIN=

# Database Connection (AWS DocumentDB or MongoDB Atlas Cloud)
MONGODB_URL=
DATABASE_NAME=vmes_parking

# FastAPI Application Settings
HOST=0.0.0.0
PORT=8000
