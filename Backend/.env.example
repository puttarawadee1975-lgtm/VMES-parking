# Database Connection URL (Set when ready to connect to a database in the future)
# Examples:
# DATABASE_URL=postgresql://username:password@localhost:5432/my_database
# DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/my_database
DATABASE_URL=

# Server Configuration
PORT=8000

# ------------------------------------------------------------------------------
# Storage Provider Configuration (Snapshot Storage)
# Options: 'local' (default) or 's3' (AWS S3 Bucket)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local

# AWS S3 Storage Credentials (Required when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=smart-parking-snapshots
# Optional Custom Domain (CloudFront CDN or custom domain)
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com
